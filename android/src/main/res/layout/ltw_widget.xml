<?xml version="1.0" encoding="utf-8"?>
<!-- An app may override this layout (same name) to restyle the widget, as
     long as it keeps every id; RemoteViews only allow framework views.
     The root's id lets Android 12+ clip the widget to the launcher's corners. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ltw_root_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/ltw_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/ltw_running"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/ltw_padding"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ltw_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ltw_dot" />

            <TextView
                android:id="@+id/ltw_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="@color/ltw_foreground"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ltw_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Chronometer
            android:id="@+id/ltw_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/ltw_foreground"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/ltw_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/ltw_muted"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/ltw_progress"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ltw_idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="@dimen/ltw_padding">

        <TextView
            android:id="@+id/ltw_idle_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/ltw_idle_title"
            android:textAlignment="viewStart"
            android:textColor="@color/ltw_foreground"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ltw_idle_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/ltw_idle_subtitle"
            android:textAlignment="viewStart"
            android:textColor="@color/ltw_muted"
            android:textSize="12sp" />

        <!-- A RelativeLayout, so the pill stretches to the label: a
             wrap_content FrameLayout never re-measures a single
             match_parent child. -->
        <RelativeLayout
            android:id="@+id/ltw_idle_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ltw_idle_action_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignStart="@+id/ltw_idle_action_label"
                android:layout_alignTop="@+id/ltw_idle_action_label"
                android:layout_alignEnd="@+id/ltw_idle_action_label"
                android:layout_alignBottom="@+id/ltw_idle_action_label"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/ltw_pill" />

            <TextView
                android:id="@+id/ltw_idle_action_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:maxLines="1"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
